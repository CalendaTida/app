# Supabase: Project Settings > API. A chave "anon public" é feita para ser pública. Nunca use a "service_role".
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# openssl rand -hex 32  (criptografa os dados; se perder, os dados salvos ficam ilegíveis)
SESSION_SECRET=

# Repositório PRIVADO de dados, ex.: CalendaTida/dados
GH_DATA_REPO=
# Token fine-grained: acesso só a esse repositório, permissão "Contents: Read and write"
GH_DATA_TOKEN=
